rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Designated bootstrapped admin from runtime or database-registered admin
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email == 'millwala27@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // Helper for timing strings
    function isValidTiming(val) {
      return val is string && val.size() <= 10;
    }

    // Validation helper for Masjid entity
    function isValidMasjid(data) {
      return data.keys().hasAll(['name']) &&
        data.keys().hasOnly(['name', 'fajr', 'zuhr', 'asr', 'magrib', 'isha', 'jumua', 'createdAt', 'updatedAt']) &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 120 &&
        (!('fajr' in data) || isValidTiming(data.fajr)) &&
        (!('zuhr' in data) || isValidTiming(data.zuhr)) &&
        (!('asr' in data) || isValidTiming(data.asr)) &&
        (!('magrib' in data) || isValidTiming(data.magrib)) &&
        (!('isha' in data) || isValidTiming(data.isha)) &&
        (!('jumua' in data) || isValidTiming(data.jumua));
    }

    // Validation helper for Admin entity
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role']) &&
        data.keys().hasOnly(['email', 'role', 'createdAt']) &&
        data.email is string &&
        data.email.size() <= 120 &&
        data.role in ['admin', 'superadmin'];
    }

    // Public Masjids Collection: Public Read, Admin Write
    match /masjids/{masjidId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(masjidId) && isValidMasjid(incoming());
      allow update: if isAdmin() && isValidId(masjidId) && isValidMasjid(incoming());
      allow delete: if isAdmin() && isValidId(masjidId);
    }

    // Admin Profiles Collection: Admin-only
    match /admins/{adminId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming());
      allow delete: if isAdmin() && isValidId(adminId);
    }

    // Test ping document for connection healthcheck
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
